// Propositum — local-first SQLite schema.
//
// Vocabulary is CONTEXT.md. ~~Every model here is a term defined there; nothing
// here invents a name.~~ Terms marked "computed view" in CONTEXT.md deliberately
// have NO table — EnforcedPolicy, Shift, ExecutionPlan, ActionStatus.
//
// **Amended 2026-08-18, and the exception is now two models rather than one, so
// it is worth naming rather than leaving to be discovered.** `CalendarConnection`
// (ADR-0014) and `OfferTally` are both absent from CONTEXT.md. Neither is a term
// about a person's work: one holds a credential and one holds how loud this
// product has been. CONTEXT.md is the vocabulary of the WORK — Intention,
// Session, Shift, Outcome — and filing "a counter about our own offer rate"
// among them would widen what that document claims to be. The debt this leaves
// is real and is stated plainly: two tables exist whose names nothing outside
// this file defines, and the next reader looking a name up in CONTEXT.md will
// not find them there.
//
// ── Two things Prisma's SQLite provider cannot express ────────────────────
//
// 1. NO ENUMS. Prisma enums are Postgres/MySQL only. Every closed set below is
//    a String, and the authoritative definition is the Zod schema in
//    src/domain. The comment on each field lists the members; the comment is
//    documentation, the Zod schema is the constraint.
//
// 2. NO TRIGGERS. Append-only is enforced by triggers in prisma/triggers.sql,
//    installed and VERIFIED at every startup by src/persistence/append-only.ts.
//    This is not belt-and-braces — Prisma's SQLite migrations DROP TRIGGERS on
//    any table rebuild (dropped column, changed column, added required column,
//    PK or FK change) with exit code 0 and no warning. The guard is a runtime
//    invariant, not a migration artifact. See ADR-0003.
//
// Verified for the run-claim path: Prisma 6.19.3 emits BEGIN IMMEDIATE for both
// interactive and batch $transaction, so no raw SQL is needed. Locked in by
// tests/prisma-transaction-mode.test.ts.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════ 1. Observation

/// One durable statement of what a person is trying to accomplish, written or
/// ratified by that person. ADR-0011.
///
/// ── MUTABLE, and it gets NO append-only triggers ─────────────────────────
///
/// Project's reasoning, verbatim: it holds no inference and carries no
/// provenance, so nothing about it is append-only. No REQUIRED_GUARDS entry, no
/// triggers.sql change, no row in tests/append-only.test.ts's hand-maintained
/// checklist. Rewriting the sentence is the correction channel and there is no
/// second one.
///
/// ── HUMAN-RATIFIED ONLY, which is a shape rather than a rule ─────────────
///
/// A person creates one and a person edits one. No detector writes one, no
/// model boundary writes one, and NO MODEL-FACING SCHEMA HAS A FIELD THAT COULD
/// CARRY ONE — the same structural bar WorkOffer stands behind. It is not
/// evidence, it carries no provenance, and inference never reads it:
/// `matchProject` gets no new input from it and no SessionReading consults it.
///
/// Ratified is not the same as written. The sentence a person accepts at the
/// offer screen was composed by a model from page titles and search terms; what
/// is structural is that no model writes the ROW.
///
/// Distinct from ActionIntent and StatedIntent, which are a prefix away and
/// share nothing with it. `intentId` in the runtime is an ActionIntent's id in
/// all 141 of its occurrences and never this. The collision is accepted, not
/// fixed — ADR-0011 §4.
model Intention {
  id String @id @default(cuid())

  /// NULLABLE, and UNIQUE: at most one Intention per Project (ADR-0011). The
  /// uniqueness is the deferral held as a shape rather than as a rule — the
  /// hard question, *which Intention does this sitting belong to?*, is safe
  /// only for as long as it cannot be asked, and a second row is where it
  /// starts being asked. Null means a statement not yet filed under a
  /// workspace.
  projectId String? @unique

  /// What the person is trying to accomplish, in their words.
  objective        String
  /// What would count as done. `definitionOfDone`, NEVER `definitionOfSuccess`
  /// — StatedIntent already owns this field name and a StatedIntent is this
  /// row's per-handoff restatement. Two words for one concept a lifecycle stage
  /// apart is what the banned-words table exists to stop.
  definitionOfDone String

  /// Set by a person, and only by a person. `IntentionState.done` derives from
  /// this and from nothing else — there is no IntentionStatus column, because
  /// two stores for one truth is exactly how a UI comes to display something
  /// the gate cannot enforce.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project?          @relation(fields: [projectId], references: [id])
  sessions  WorkSession[]
  contracts HandoffContract[]

  @@map("intention")
}

/// The single durable workspace. Owns every ApprovedSource, Document and
/// WorkSession. Holds no objective, no status and no description — a
/// description that inference reads is a project goal in disguise.
///
/// A Project may own AT MOST ONE Intention (ADR-0011), and the ban above is
/// untouched: the objective lives on the Intention, which is human-ratified and
/// — the half that carries the ban — never read by the detector. `matchProject`
/// still compares subject words to `name` and gains no new input.
model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  sources   ApprovedSource[]
  sessions  WorkSession[]
  documents Document[]
  intention Intention?

  @@map("project")
}

/// One explicitly started and explicitly ended stretch of desk time. A sitting,
/// not a single intention. Survives handoffs, idle, lid close, sleep, service
/// worker death and permission revocation — only a human act ends it.
model WorkSession {
  id          String    @id @default(cuid())
  projectId   String
  /// The Intention this sitting advances, if the person has stated one.
  ///
  /// NULLABLE, and NOTHING BACKFILLS IT (ADR-0011). Every session recorded
  /// before that ADR keeps a null, which is the honest value: nobody wrote an
  /// Intention for them. A sitting may point at ONE, at none, and never at two.
  intentionId String?
  /// SessionPhase: observing | away | ended
  phase       String    @default("observing")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  project   Project            @relation(fields: [projectId], references: [id])
  /// `SetNull` is DECLARED rather than inherited from Prisma's default for an
  /// optional relation, because the two nullable Intention keys want opposite
  /// answers and a default cannot say which. Here null is already the ordinary
  /// value and already means *nobody stated an Intention for this sitting*, so
  /// a deleted Intention leaving that behind says something true. Nothing about
  /// a WorkSession is frozen, so this UPDATE meets no trigger.
  intention Intention?         @relation(fields: [intentionId], references: [id], onDelete: SetNull)
  events    ObservationEvent[]
  readings  SessionReading[]
  contracts HandoffContract[]
  offer     WorkOffer?

  @@index([projectId])
  @@map("work_session")
}

/// An origin pattern the human approved for this Project, mirroring a Chrome
/// host-permission grant. Approval scopes where Propositum may LOOK; it confers
/// no trust on what is found there.
model ApprovedSource {
  id             String   @id @default(cuid())
  projectId      String
  originPattern  String
  label          String
  /// granted | revoked
  grantState     String   @default("granted")
  grantCheckedAt DateTime @default(now())

  project Project            @relation(fields: [projectId], references: [id])
  events  ObservationEvent[]

  @@unique([projectId, originPattern])
  @@map("approved_source")
}

/// APPEND-ONLY. One deterministic, timestamped record of a single thing that
/// happened. Written by the single ledger writer, NEVER minted by a model — if
/// a model emitted events, an inference would cite the event and the event
/// would BE the inference, making H1 unmeasurable.
model ObservationEvent {
  id               String   @id @default(cuid())
  sessionId        String
  /// Ledger-assigned, gapless by construction. The ordering key.
  seq              Int
  /// Adapter-assigned. A skip or regression is a GAP SIGNAL, never an ordering key.
  sourceSeq        Int?
  observedAt       DateTime
  /// Source-supplied, so a 40-minute fixture replays in 400ms. Never Date.now().
  elapsedMs        Int
  /// ObservationKind: visited | queried | excerpted | engaged | returnedTo |
  /// switchedAway | documentEdited | note | sourceApproved | captureGap
  kind             String
  approvedSourceId String?
  documentId       String?
  /// Values Chrome or Propositum itself asserted. Safe to reason over.
  attested         Json
  /// UntrustedContent — anything a page could have authored. NOTHING here may
  /// influence a policy decision, be treated as an instruction, or enter a
  /// prompt without datamarking. Carried structurally, not by a per-field flag.
  untrusted        Json?

  session WorkSession     @relation(fields: [sessionId], references: [id])
  source  ApprovedSource? @relation(fields: [approvedSourceId], references: [id])

  @@unique([sessionId, seq])
  @@index([sessionId, kind])
  @@map("observation_event")
}

// ═══════════════════════════════════════════════════════════ 2. Inference

/// A structured interpretation of a WorkSession. Named "Reading" rather than
/// "State" so it never collides with SessionPhase in the authorization path.
model SessionReading {
  id          String   @id @default(cuid())
  sessionId   String
  createdAt   DateTime @default(now())
  /// Highest ObservationEvent.seq this reading saw. Makes the reading
  /// reproducible and tells the eval exactly what input produced it.
  throughSeq  Int
  /// Set only on references authored for the eval harness, before any model
  /// output exists. A reference is never edited after a run.
  isReference Boolean  @default(false)

  session   WorkSession       @relation(fields: [sessionId], references: [id])
  claims    SessionClaim[]
  contracts HandoffContract[]

  @@index([sessionId])
  @@map("session_reading")
}

/// One assertion within a reading. Flat object with a `kind` string, NOT a
/// discriminated union — `const` is verified not to survive schema
/// transformation (#3), so a bad discriminator would make the whole union
/// unresolvable, whereas a flat shape fails on one named field.
model SessionClaim {
  id         String  @id @default(cuid())
  readingId  String
  /// objective | completed | openThread | constraint | nextAction | uncertainty
  kind       String
  text       String
  /// Per claim, never per reading. Revision-level authorship would launder
  /// every unedited inferred claim into a human assertion the moment the human
  /// fixes one word — and make handoff correction rate uncomputable.
  /// inferred | human | edited
  origin     String  @default("inferred")
  /// ObjectiveConfidence, on the objective claim only: high | medium | low.
  /// Never a number, never compared against a tunable threshold, and NOT a
  /// control-flow input — Take Over gates on an objective existing and having
  /// been seen, not on the band.
  confidence String?
  ordinal    Int

  reading  SessionReading @relation(fields: [readingId], references: [id])
  evidence Evidence[]

  @@index([readingId, kind])
  @@map("session_claim")
}

/// The link from one claim to one ObservationEvent, plus an optional verified
/// quote. A claim whose every cited id fails to resolve FAILS VALIDATION — an
/// inference with no provenance violates a binding constraint.
model Evidence {
  id      String  @id @default(cuid())
  claimId String
  eventId String
  /// Kept only if it matches a canonical normalised form of the cited event's
  /// stored text. Raw substring matching would discard nearly every quote,
  /// because the injection defence guarantees the model never saw the raw
  /// string. Discarded quotes are COUNTED — fabricated support is an H1 datum.
  quote   String?

  claim SessionClaim @relation(fields: [claimId], references: [id])

  @@index([claimId])
  @@map("evidence")
}

// ═══════════════════════════════════════════════════════════ 3. Handoff

/// INSERT-ONLY, and written ONLY on acceptance.
///
/// What Propositum offered to do, once the person said yes. Before that a
/// WorkOffer lives in the in-memory ambient store and dies with the process,
/// which is the same rule ADR-0008 applies to ambient observations and for the
/// same reason: a durable row saying "Propositum thought you were job-hunting"
/// for an offer NOBODY ACCEPTED is exactly the profile the ambient buffer
/// refuses to become. Declining must cost nothing and leave nothing, or the
/// honest thing to do with the feature is turn it off.
///
/// ── It grants nothing ────────────────────────────────────────────────────
///
/// This is the load-bearing property, and it is worth being blunt about
/// because the model wrote most of the row. `title`, `rationale`, `outline`,
/// `produces` and `excludes` are PROSE. Nothing reads them to decide anything.
/// The only field that reaches a scope decision is `originPatterns`, and that
/// is CODE-DERIVED from the pages the detected thread actually ran through —
/// never model-authored, never widened by anything the model said. So the worst
/// a compromised or confused offer can do is describe work badly; it cannot
/// describe its way into a source the person never visited.
model WorkOffer {
  id              String   @id @default(cuid())
  /// The session accepting the offer started. Unique — one offer per session,
  /// because accepting is what creates the session.
  sessionId       String   @unique
  /// The detected thread this offer was composed for, keyed the same way the
  /// ambient store keys it. Ties the durable row back to the deterministic
  /// detection that preceded it.
  threadSignature String
  promptVersion   String
  /// Model-authored, DISPLAY-ONLY.
  title           String
  rationale       String
  /// OfferOutline — ordered one-line intentions, so the person can see the
  /// SHAPE of what was offered before agreeing to it.
  ///
  /// DISPLAY ONLY. These are never turned into PlanSteps and are never binding
  /// on the plan. The temptation to bind them is strong and wrong: the outline
  /// is written before any planning happens, from titles and search terms
  /// alone, and a plan pinned to it would be a plan pinned to a guess made with
  /// the least information anyone will ever have about the work.
  outline         Json
  produces        String
  excludes        Json
  /// ContractScope material, CODE-DERIVED from the pages the thread ran
  /// through. NEVER model-authored — see the header.
  originPatterns  Json
  /// ShiftOutcomeKind[]. Coerced in code against the closed set; a kind the
  /// model invented is dropped, not stored.
  expectedKinds   Json
  /// OfferGrounds — what the detector saw, frozen at acceptance.
  ///
  /// Frozen rather than recomputed, because the ambient buffer it came from is
  /// bounded by a 30-minute window and a 500-row cap and will not contain the
  /// answer an hour later. Without this the shift report can say what was done
  /// and not WHY IT WAS ASKED, and "why did it offer me this" is the question a
  /// person asks first when an offer was wrong.
  grounds         Json
  createdAt       DateTime @default(now())

  session WorkSession @relation(fields: [sessionId], references: [id])

  @@map("work_offer")
}

/// The persisted, human-ratified agreement governing exactly one autonomous
/// continuation. No AgentRun may start from an unaccepted contract, and NOTHING
/// in the controls can switch off human ratification.
model HandoffContract {
  id          String    @id @default(cuid())
  sessionId   String
  readingId   String
  /// Which Intention this contract ADVANCES — nothing more. It grants nothing,
  /// the gate does not read it, and `compilePolicy` cannot receive it.
  ///
  /// NULLABLE, and written AT DRAFT TIME. Every contract written before
  /// ADR-0011 keeps a null and none are backfilled — and none could be:
  /// `handoff_contract_frozen_once_accepted` permits an UPDATE only while
  /// `status = 'draft'`, so a column filled in after acceptance is a column
  /// that cannot be filled in at all.
  intentionId String?
  /// draft | accepted — two values only. Supersession would be derived from a
  /// successor's supersedesId, so the immutability trigger has a single job.
  status      String    @default("draft")
  /// The shift start AND the origin of the deadline, so a crash-restart cannot
  /// silently reset the budget. Deadline is DERIVED, never stored.
  acceptedAt  DateTime?

  /// StatedIntent — human-ratified but still PROSE, because spans of it
  /// originate in page-derived text. compilePolicy's parameter types are
  /// constructed so they cannot receive this.
  objective        String
  definitionOfDone String
  /// Deliberately unenforceable, labelled as such in the UI. Human-typed only —
  /// an inferred `constraint` claim NEVER pre-populates it.
  guidance         Json

  /// ContractScope — deny by default, no denylist. A second mechanism would
  /// create a precedence question with no principled answer.
  approvedSourceIds  Json
  /// ActionKind[]: read-approved-source | read-document | draft-section
  allowedActionKinds Json
  /// NULLABLE. A run no longer necessarily has a document.
  ///
  /// This column was required because every Shift was a document Shift: the
  /// worker drafted prose, deterministic code diffed it against a pinned base,
  /// and the base was the whole point. Once a Shift can act in a browser and
  /// produce an answer, a collection or a message draft, pinning a
  /// DocumentVersion is no longer something every contract can honestly do —
  /// and a required column would force the person to invent a document so the
  /// schema would let them hand work over.
  ///
  /// NULL means "this Shift pins no document", not "we forgot to pin one". The
  /// consequence is deliberate and lives in the gate rather than here: with no
  /// base pinned there is nothing for `read-document` or `draft-section` to
  /// address, so those refuse rather than guess. Everything that already
  /// depends on an immutable base — refuse-on-drift, the settled-once foreign
  /// key, offsets into the base — is untouched, because it only ever runs on
  /// the branch where a base exists.
  baseVersionId      String?

  /// AutonomyControls. Absent from every model-facing schema; defaults are
  /// static product constants, never model-proposed.
  /// follow-closely | use-judgment
  initiative       String
  /// current-step-only | remaining-plan
  progress         String
  /// suggestions-only | draft-changes — a REAL permission: suggestions-only
  /// removes draft-section from allowedActionKinds.
  output           String
  /// stop-when-uncertain | stop-only-when-blocked
  interruption     String
  /// Time only. Never a cost ceiling — measured at ~$0.009 and ~7.8s per call,
  /// a 30-minute budget is about $2, so latency binds and cost never does.
  timeLimitMinutes Int

  session     WorkSession      @relation(fields: [sessionId], references: [id])
  reading     SessionReading   @relation(fields: [readingId], references: [id])
  /// `Restrict`, DECLARED — and this is the one referential action in the file
  /// worth reading twice.
  ///
  /// Prisma's default for an optional relation is `SetNull`, and `SetNull` here
  /// is an UPDATE on this table. `handoff_contract_frozen_once_accepted` aborts
  /// any UPDATE where `OLD.status = 'accepted'`, and SQLite's
  /// SQLITE_CONSTRAINT_TRIGGER comes back through Prisma as P2003 *"Foreign key
  /// constraint violated"* — so deleting an Intention that an accepted contract
  /// advanced would have failed with an error naming a relation problem that
  /// did not exist. Worse in the other direction: on a DRAFT contract the same
  /// default would silently erase the record of which Intention it advances.
  ///
  /// `Restrict` refuses the delete outright, for drafts and accepted rows
  /// alike, and its P2003 is then TRUE — there really is a row referencing this
  /// one. THE HONEST LIMIT, stated rather than discovered: an Intention that any
  /// HandoffContract points at cannot be deleted at all. ADR-0011 says a person
  /// can *"see, edit and delete"* an Intention; see and edit are unrestricted
  /// (nothing here freezes this row), delete is not, and the eventual
  /// `IntentionRepository.delete` must be written against that rather than
  /// against a capability this storage layer does not have.
  intention   Intention?       @relation(fields: [intentionId], references: [id], onDelete: Restrict)
  baseVersion DocumentVersion? @relation(fields: [baseVersionId], references: [id])
  runs        AgentRun[]
  changesets  Changeset[]
  report      ShiftReport?

  @@index([sessionId])
  @@map("handoff_contract")
}

// ═══════════════════════════════════════════════════════════ 4. Execution

/// One ephemeral worker-or-reviewer execution. Queue entry and domain record in
/// ONE row — two stores for one truth is how a UI comes to show something the
/// gate cannot enforce.
///
/// MUTABLE BY DESIGN. The ledger is append-only; this row is not. It is the
/// claim target, and a claim is by definition a mutation.
model AgentRun {
  id             String    @id @default(cuid())
  contractId     String
  /// worker | reviewer
  role           String
  /// pending | claimed | running | succeeded | failed | interrupted |
  /// awaiting-confirmation.
  ///
  /// `awaiting-confirmation` is terminal FOR THIS RUN and is not a failure. The
  /// gate refused an action that needs the person, the run wrote a
  /// ConfirmationRequest and stopped; if the person confirms, a SUCCESSOR run
  /// carrying `resumesRunId` continues from there. That is why it is a status
  /// and not a flag: a paused run that still holds a lease would either be
  /// reaped by the sweep while the person was reading the request, or would
  /// hold a claim for as long as they took to answer, which may be overnight.
  status         String    @default("pending")
  /// lease-expired | budget-exhausted | stop-condition | cancelled | error
  terminalReason String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  endedAt        DateTime?
  /// Renewed by the worker. A startup sweep marks expired leases `interrupted`
  /// — Node never kills its children, so orphans are the default, not the edge.
  leaseUntil     DateTime?
  /// Monotonic high-water mark, so PlanSteps stay immutable.
  progressStep   Int       @default(0)

  /// The secret this run must present to drive the browser control channel.
  /// Nullable because only a run that acts in Chrome needs one, and a run that
  /// does not should not be issued a credential it cannot use. It is not an
  /// authorization: the gate still decides every action. It only answers "is
  /// this the run the extension agreed to take instructions from", which
  /// matters because the channel's other end is a browser extension that any
  /// page in the browser shares a process boundary with.
  controlToken    String?
  /// The person asked this run to stop. Deterministic code reads it at action
  /// boundaries and halts; nothing here cancels anything by itself.
  ///
  /// NOTE, and this is the uncomfortable part: `cancelRequested` and
  /// `claimedBy` are BOTH described in CONTEXT.md — §4 says in as many words
  /// that "every action boundary re-reads `status` and `claimedBy`; a Runner
  /// that no longer holds the claim aborts without writing" — and NEITHER HAS
  /// EVER EXISTED IN THIS SCHEMA. The fence CONTEXT describes has never been
  /// real. It did not matter much while the worst a stale run could do was
  /// append a draft nobody asked for to a document under review. A
  /// browser-driving run is the first run where a stale claim can press a
  /// button on a live page, so the columns arrive here rather than staying a
  /// paragraph.
  cancelRequested Boolean @default(false)
  /// Which process holds the claim. See the note on `cancelRequested`: this is
  /// the other half of a fence CONTEXT.md has always documented and the
  /// database has never had.
  claimedBy       String?
  /// The run this one continues, set when a ConfirmationRequest was confirmed
  /// and the work picked up where it stopped. Deliberately a plain id and not a
  /// self-relation: this is provenance for the report to read, not a graph
  /// anything traverses, and a self-relation would invite one.
  resumesRunId    String?

  contract      HandoffContract       @relation(fields: [contractId], references: [id])
  steps         PlanStep[]
  intents       ActionIntent[]
  calls         ModelCallRecord[]
  findings      ReviewFinding[]
  outcomes      ShiftOutcome[]
  confirmations ConfirmationRequest[]
  evidence      ActionEvidence[]
  dispatches    ActionDispatch[]

  @@index([status, createdAt])
  @@index([contractId])
  @@map("agent_run")
}

/// One step of the ExecutionPlan. The plan itself is a COMPUTED VIEW — an
/// ordered list, not a bounded graph. A graph implies dependencies and
/// parallelism one worker and one reviewer cannot use.
model PlanStep {
  id      String @id @default(cuid())
  runId   String
  ordinal Int
  intent  String

  run     AgentRun       @relation(fields: [runId], references: [id])
  intents ActionIntent[]

  @@unique([runId, ordinal])
  @@map("plan_step")
}

/// APPEND-ONLY. One row per gate evaluation, written and COMMITTED BEFORE any
/// effect. A run that dies mid-action must still show what it was attempting —
/// that is exactly when the audit story matters most.
///
/// A REFUSAL is an ActionIntent with authorized=false and no ActionOutcome. It
/// is evidence about H3, so it must be queryable.
model ActionIntent {
  id          String   @id @default(cuid())
  runId       String
  stepId      String?
  seq         Int
  /// ActionKind. The closed set lives in src/domain/handoff/policy.ts and is
  /// nine wide since the browser capabilities landed:
  ///   read-approved-source | read-document | draft-section
  ///   observe-page | navigate | click-element | type-text | press-key
  ///   capture-screen
  ///
  /// Rows written before that are still valid and still carry one of the first
  /// three — this column is append-only and describes what was proposed at the
  /// time, not what the enum holds today.
  kind        String
  /// Why the worker proposed this. Exists BEFORE the action runs.
  reason      String
  params      Json
  authorized  Boolean
  /// Set only when authorized=false. Deterministic rule id, never prose. The
  /// closed set is `RefusalRule` in src/policy/gate.ts — seventeen of them
  /// since the gate learned to drive a browser. Examples across the range:
  /// source_not_approved, action_kind_not_allowed, budget_exhausted,
  /// unknown_action_kind, stale_snapshot, confirmation_required,
  /// no_document_pinned, password_field.
  ///
  /// `confirmation_required` is the one worth knowing about when reading a
  /// ledger: it is not a failure, it is the gate stopping to ask the person,
  /// and a later intent in the same Shift carries the same proposal allowed.
  refusedRule String?
  createdAt   DateTime @default(now())

  run          AgentRun             @relation(fields: [runId], references: [id])
  step         PlanStep?            @relation(fields: [stepId], references: [id])
  outcome      ActionOutcome?
  confirmation ConfirmationRequest?
  dispatch     ActionDispatch?
  evidence     ActionEvidence[]

  @@unique([runId, seq])
  @@index([runId, authorized])
  @@map("action_intent")
}

/// APPEND-ONLY. Written after the action completes. Separate from ActionIntent
/// because the reason precedes the action and the result follows it — one row
/// holding both would force an UPDATE, which append-only forbids. This split
/// resolves a contradiction in the founding brief's own ActionRecord definition.
model ActionOutcome {
  id           String   @id @default(cuid())
  intentId     String   @unique
  /// succeeded | failed
  result       String
  /// within_scope | out_of_scope | unverified. `unverified` covers both
  /// "nothing happened" and "we cannot tell" — and under the sleep constraint
  /// it is the ROUTINE value, not the exception.
  scopeVerdict String
  detail       String?
  /// For draft-section actions only.
  draftText    String?
  /// Who observed this result. NULL = the authorising run saw it itself.
  /// `recovery` = a bounded startup sweep recorded it afterwards, and may only
  /// write what it can prove by hash — it may never infer.
  ///
  /// CONTEXT.md §4 has specified this field since the vocabulary was written
  /// and the schema has never carried it, which left the `unknown` ActionStatus
  /// — authorized, zero outcomes — indistinguishable from a run that genuinely
  /// did nothing. Its first writer is the recovery sweep, and that is the whole
  /// point of adding it now: today a run that dies between the effect and the
  /// outcome write leaves a trailing `unknown` forever, and under the standing
  /// "a local worker stops when the Mac sleeps" constraint that is ROUTINE, not
  /// an edge case. The sweep converts a reporting gap into a recorded fact —
  /// `observedBy = 'recovery'` with `scopeVerdict = 'unverified'`, which reads
  /// as "an effect landed and no check ran" rather than as reassurance.
  observedBy   String?
  createdAt    DateTime @default(now())

  intent ActionIntent @relation(fields: [intentId], references: [id])

  @@map("action_outcome")
}

/// APPEND-ONLY. Every model call, for traceability and cost. Distinct from
/// ActionIntent: a model call is not an action the person authorized, and the
/// ledger they READ must not list them.
model ModelCallRecord {
  id            String   @id @default(cuid())
  runId         String?
  /// One of `BOUNDARY_NAMES` in src/model/client.ts, which is the source of
  /// truth. EIGHT, not the six this line listed until the first writer landed:
  /// `subject` (ADR-0008) and `offer` (ADR-0009) arrived later and nothing
  /// updated the list, which was invisible for as long as nothing wrote a row.
  /// session-reading | handoff | plan | worker-action | review | shift-report |
  /// subject | offer
  boundary      String
  model         String
  promptVersion String
  inputTokens   Int
  outputTokens  Int
  latencyMs     Int
  /// end_turn | max_tokens | refusal | stop_sequence
  stopReason    String?
  /// NULL when the attempt succeeded. `FailureKind` has no member meaning "it
  /// worked", and a `none` string beside a nullable column would be two
  /// spellings of success in one column.
  /// schema-mismatch | truncation | refusal | transport
  failureKind   String?
  repairTurns   Int      @default(0)
  createdAt     DateTime @default(now())

  run AgentRun? @relation(fields: [runId], references: [id])

  @@index([runId])
  @@map("model_call_record")
}

// ══════════════════════════════════ 4b. Acting in the browser, and its result
//
// Everything below is new with the computer-use path, and one property is
// shared by all of it: the models here point at `agent_run` and `action_intent`
// with declared relations, not with loose ids. ADR-0003's provenance walk turns
// on the sentence "every hop is a foreign key", and a screenshot or a dispatch
// carrying a runId the database does not check is a hop that can rot silently.
// The one place an id is deliberately NOT a foreign key is
// `ShiftOutcome.citedActionIntentIds`, which is a set rather than a link and is
// validated in code against the run's own completed intents — see there.

/// INSERT-ONLY. One thing a Shift produced.
///
/// This is the run's RESULT, and putting it here rather than under documents is
/// the point of the model. The document path — Changeset, ProposedChange,
/// ChangeVerdict — was never wrong, it was just the ONLY thing a Shift could
/// end with, so it became the spine by default. It is now ONE KIND AMONG FIVE.
/// A Shift that read three pages and answered a question produced something
/// real, and before this table the only way to say so was to write it into a
/// document nobody asked for.
model ShiftOutcome {
  id                   String   @id @default(cuid())
  runId                String
  ordinal              Int
  /// ShiftOutcomeKind: document-changes | collection | answer | message-draft |
  /// external-effect.
  ///
  /// CLOSED and CODE-OWNED. Deterministic code decides the kind; a worker
  /// returns a shape and code reads the shape. There is deliberately NO
  /// `other` — the same rule as ObservationKind, and for the same reason: an
  /// escape hatch turns a closed set into an open one on the first awkward
  /// case, and then nothing downstream can render a kind it has never seen. A
  /// production matching no kind is DROPPED AND COUNTED, because the count is
  /// the evidence that the set is wrong, and a silent drop is not.
  kind                 String
  /// Reversibility: held | landed. CODE-ASSIGNED, never model-assigned.
  ///
  /// `held` means Propositum is still holding the thing and the person's accept
  /// or reject decides its fate. `landed` means the effect is ALREADY OUTSIDE
  /// PROPOSITUM — a form was submitted, a message was sent, a booking exists.
  /// There is no verdict to offer on a landed outcome and the UI must not
  /// pretend there is: an Accept/Reject pair over something that already
  /// happened is a lie about what the buttons do, and it is exactly the lie
  /// that makes a person stop reading them.
  reversibility        String
  /// Model-authored prose, display-only.
  headline             String
  /// Why this was produced.
  ///
  /// Denormalised on purpose. The one-minute re-entry list has to render
  /// without touching the ledger, and — the stronger half of the argument — the
  /// reason must SURVIVE REJECTION. This is the same argument as
  /// ProposedChange.reason: after the person rejects an outcome, "what was it
  /// trying to do" is the only question left worth answering, and a reason
  /// assembled by joining live rows is a reason that changes shape depending on
  /// what else was cleaned up.
  reason               String
  /// The completed ActionIntents this outcome rests on, validated against THIS
  /// RUN'S OWN completed intents. An id not among them is dropped.
  ///
  /// A Json set rather than a join table, because it closes the provenance
  /// chain as A JOIN, NOT A CLAIM: nothing here is trusted, the ids are checked
  /// against rows the gate already authorised, and what survives is
  /// intersection rather than assertion. A join table would add a second place
  /// for the same fact to disagree with itself.
  citedActionIntentIds Json
  /// Kind-shaped payload, canonical JSON.
  ///
  /// NEVER document bodies. A `document-changes` outcome points at a Changeset
  /// instead, so the immutable-base machinery stays the single owner of
  /// document text and this column cannot become a second, unversioned copy of
  /// it that drifts.
  detail               Json
  createdAt            DateTime @default(now())

  run       AgentRun        @relation(fields: [runId], references: [id])
  verdict   OutcomeVerdict?
  changeset Changeset?
  findings  ReviewFinding[]

  @@unique([runId, ordinal])
  @@map("shift_outcome")
}

/// APPEND-ONLY. The human's decision on one non-document ShiftOutcome.
///
/// A SIBLING of ChangeVerdict, not a replacement. Merging them was considered
/// and is worse: a ChangeVerdict addresses a ProposedChange at character
/// offsets into an immutable base and feeds a pure fold, while this addresses a
/// whole production and feeds nothing. One table would need a nullable half for
/// each case and a discriminator that only ever has one right answer, and the
/// review fold — the code that must stay obviously correct — would have to
/// filter rows that cannot possibly apply to it.
model OutcomeVerdict {
  id         String   @id @default(cuid())
  outcomeId  String   @unique
  /// accept | reject | edit
  verdict    String
  /// Set only when verdict = edit.
  editedText String?
  createdAt  DateTime @default(now())

  shiftOutcome ShiftOutcome @relation(fields: [outcomeId], references: [id])

  @@map("outcome_verdict")
}

/// APPEND-ONLY. The gate determined this action needs the person.
///
/// NOT a DecisionNeeded, and the difference is the whole reason this is a
/// separate table. A DecisionNeeded is the WORKER DECLINING a judgment call: it
/// is model-raised, it is a question about the work, and the Interruption dial
/// can suppress it — `stop-only-when-blocked` exists precisely so a person can
/// say "don't ask me about every wording choice". This is deterministic. Code
/// looked at an authorised action, saw an effect that leaves Propositum, and
/// refused to take it without a human. NO DIAL CAN SWITCH IT OFF, because a
/// control that could would be a control that turns off human ratification, and
/// nothing in the controls may do that.
model ConfirmationRequest {
  id         String   @id @default(cuid())
  runId      String
  /// The REFUSED intent that produced this. Unique: one intent, one request.
  intentId   String   @unique
  /// CODE-GENERATED from attested facts — the browser-attested URL, the action
  /// kind, the element the gate matched. NEVER model prose. The person is being
  /// asked to authorise a specific effect, and a sentence the model wrote about
  /// what it intends is not evidence of what will happen.
  summary    String
  /// The ActionEvidence the person should look at while deciding — usually the
  /// snapshot of the page the action would land on.
  evidenceId String?
  createdAt  DateTime @default(now())

  run      AgentRun             @relation(fields: [runId], references: [id])
  intent   ActionIntent         @relation(fields: [intentId], references: [id])
  evidence ActionEvidence?      @relation(fields: [evidenceId], references: [id])
  verdict  ConfirmationVerdict?

  @@index([runId])
  @@map("confirmation_request")
}

/// APPEND-ONLY. Only a human writes one.
///
/// No model, no worker run and no reviewer run may. That is not enforceable by
/// a column — the database cannot see who is holding the keyboard — so it is
/// enforced by there being exactly one writer, in the app process, on a request
/// the person is looking at. Saying it here is the point: the next person to
/// need a confirmation resolved from inside a run must change this comment
/// before they can change the rule.
model ConfirmationVerdict {
  id        String   @id @default(cuid())
  requestId String   @unique
  /// confirmed | rejected
  verdict   String
  decidedAt DateTime @default(now())

  request ConfirmationRequest @relation(fields: [requestId], references: [id])

  @@map("confirmation_verdict")
}

/// APPEND-ONLY. What the agent saw while acting under a ratified contract.
///
/// DISJOINT FROM ObservationEvent, and this is a standing rule rather than a
/// tidiness preference. ObservationEvent is what Propositum retains about THE
/// PERSON'S OWN BROWSING, and the published retention promise is a product
/// constant: title, cleaned URL, deliberate selections verbatim, and at most
/// 2,000 characters of readable text per approved source. An agent driving a
/// browser must capture whole accessibility trees and screenshots to act at
/// all. Those two things cannot share a table without one of them becoming a
/// lie — and it would be the promise that broke, quietly, the first time a
/// screenshot landed in the ledger the person reads.
model ActionEvidence {
  id        String   @id @default(cuid())
  runId     String
  intentId  String?
  /// page-snapshot | screen-capture
  kind      String
  /// Browser-attested. Chrome said this is where the tab is; the page did not.
  url       String
  /// UntrustedContent — page-authored, so sanitised, bounded, and NEVER
  /// interpolated raw into a prompt. Carried structurally, exactly as
  /// ObservationEvent.untrusted is, so the trust boundary is a shape and not a
  /// habit.
  untrusted Json?
  image     Bytes?
  /// Whether the capture was cut short of what the page actually held. A
  /// truncated tree that reads as complete is how an agent concludes a button
  /// does not exist.
  truncated Boolean  @default(false)
  createdAt DateTime @default(now())

  run      AgentRun              @relation(fields: [runId], references: [id])
  intent   ActionIntent?         @relation(fields: [intentId], references: [id])
  requests ConfirmationRequest[]

  @@index([runId])
  @@map("action_evidence")
}

/// MUTABLE BY DESIGN. One instruction handed to the browser control channel.
///
/// This is the claim target for the channel, exactly the role AgentRun plays
/// for runs, and for the same reason: the queue is a status column and one
/// guarded conditional UPDATE, not new infrastructure. It is deliberately NOT
/// append-only — a claim is by definition a mutation, and pretending otherwise
/// would mean a second table to hold the mutable half.
///
/// The ledger consequence is worth stating: this row is not evidence. The
/// append-only record of what was attempted is the ActionIntent, written and
/// committed before this row exists. A dispatch that is delivered twice, lost,
/// or abandoned changes nothing about what the audit trail says was authorised.
model ActionDispatch {
  id          String    @id @default(cuid())
  runId       String
  /// IDEMPOTENCY KEY. One authorised intent yields at most one dispatch, so a
  /// worker retry after a transport error cannot double-deliver — which for a
  /// browser action means clicking twice.
  intentId    String    @unique
  kind        String
  params      Json
  /// queued | delivered | reported | abandoned
  status      String    @default("queued")
  createdAt   DateTime  @default(now())
  deliveredAt DateTime?
  reportedAt  DateTime?

  run    AgentRun     @relation(fields: [runId], references: [id])
  intent ActionIntent @relation(fields: [intentId], references: [id])

  @@index([runId, status])
  @@map("action_dispatch")
}

// ══════════════════════════════════════════════ 5. Documents and review

/// A Markdown document. Not "Artifact" — slice 0 has exactly one content type,
/// and a supertype with one subtype is speculative generality.
model Document {
  id        String   @id @default(cuid())
  projectId String
  title     String
  createdAt DateTime @default(now())

  project  Project           @relation(fields: [projectId], references: [id])
  versions DocumentVersion[]

  @@index([projectId])
  @@map("document")
}

/// INSERT-ONLY. A full content snapshot, normalised to one sentence per line.
///
/// Snapshots rather than diffs: a local single-user Markdown document is small,
/// and an immutable base that can be read without replaying a chain is worth
/// far more than the bytes.
model DocumentVersion {
  id                       String   @id @default(cuid())
  documentId               String
  ordinal                  Int
  /// sha256 of `content`. Gates refuse-on-drift — the human is never locked out
  /// of their own document, so the base CAN move under a live Shift, and this
  /// is how review detects it.
  contentHash              String
  content                  String
  /// human | accepted-changeset. Null run means the human wrote it directly.
  origin                   String
  /// The changeset this version was folded from, for an `accepted-changeset`
  /// version. Null when the human wrote it directly.
  ///
  /// Unique, so a changeset settles exactly once: the foreign key IS the
  /// "already reviewed" flag, rather than a second nullable boolean that could
  /// disagree with it.
  committedFromChangesetId String?  @unique
  createdAt                DateTime @default(now())

  document      Document          @relation(fields: [documentId], references: [id])
  contracts     HandoffContract[]
  changesets    Changeset[]
  committedFrom Changeset?        @relation("settled", fields: [committedFromChangesetId], references: [id])

  @@unique([documentId, ordinal])
  @@map("document_version")
}

/// INSERT-ONLY. The set of changes one Shift proposes against an immutable base.
///
/// The worker returns PROSE, not patches; deterministic code diffs it against
/// the base to produce these. The model never asserts what changed — only what
/// the text should say. That is "models propose, deterministic code authorizes"
/// applied to document editing.
model Changeset {
  id            String   @id @default(cuid())
  contractId    String
  baseVersionId String
  /// Re-checked at review time. If the base moved, the whole changeset is
  /// refused rather than merged — the human's own edit always wins.
  baseHash      String
  /// The `document-changes` ShiftOutcome this changeset is the body of.
  ///
  /// Nullable, and `contractId` STAYS. It would be tidy to reparent the
  /// changeset onto the outcome and drop the contract link, and it would break
  /// two things that already work: `changesets.forContract` is how the review
  /// screen finds the changes, and the settled-once unique foreign key from
  /// DocumentVersion depends on nothing about this row moving. A document Shift
  /// that produces no ShiftOutcome — every one that has ever run — must keep
  /// working unchanged, so this is a link the outcome path adds, not a spine
  /// the document path is rehomed onto.
  outcomeId     String?  @unique
  createdAt     DateTime @default(now())

  contract     HandoffContract  @relation(fields: [contractId], references: [id])
  base         DocumentVersion  @relation(fields: [baseVersionId], references: [id])
  shiftOutcome ShiftOutcome?    @relation(fields: [outcomeId], references: [id])
  changes      ProposedChange[]
  /// Present once the person finished the review and the kept changes became a
  /// new version. Its absence is what "still open" means.
  settledAs    DocumentVersion? @relation("settled")

  @@index([contractId])
  @@map("changeset")
}

/// One proposed change, addressed by character offsets into the BASE version.
///
/// Offsets are safe because review produces DECISIONS, NEVER DOCUMENTS:
/// materialise(base, changes, decisions) is a pure right-to-left fold, so
/// accepting one change never shifts another. Heading-path addressing was
/// rejected — it cannot distinguish two changes inside one section, and
/// renaming a heading is a likely edit, so the anchor breaks precisely when the
/// worker does its job well.
model ProposedChange {
  id          String @id @default(cuid())
  changesetId String
  /// Character offsets into base content.
  startOffset Int
  endOffset   Int
  /// W3C-style quote anchor, verified against the base before rendering.
  prefix      String
  exact       String
  suffix      String
  replacement String
  /// Why this change. Shown inline without cluttering the diff.
  reason      String

  changeset Changeset       @relation(fields: [changesetId], references: [id])
  verdict   ChangeVerdict?
  findings  ReviewFinding[]

  @@index([changesetId])
  @@map("proposed_change")
}

/// APPEND-ONLY. The human's decision on one ProposedChange. These are what
/// review produces — never a materialised document.
model ChangeVerdict {
  id         String   @id @default(cuid())
  changeId   String   @unique
  /// accept | reject | edit
  verdict    String
  /// Set only when verdict = edit.
  editedText String?
  createdAt  DateTime @default(now())

  change ProposedChange @relation(fields: [changeId], references: [id])

  @@map("change_verdict")
}

/// The reviewer's annotation on a change. DISPLAY ONLY — scope adherence is
/// scored from deterministic fields, so a finding grants and blocks nothing.
/// The reviewer is close to decorative in slice 0; the brief mandates it, and
/// whether it earns its place is a measured question, not an assumed answer.
model ReviewFinding {
  id        String  @id @default(cuid())
  runId     String
  changeId  String?
  /// The non-document production this finding annotates. AT MOST ONE of
  /// `changeId` and `outcomeId` is set; a finding about the run as a whole sets
  /// neither, which is already how `changeId` behaves.
  ///
  /// Two nullable foreign keys where a polymorphic target would be tempting.
  /// They cost nothing here precisely BECAUSE a finding is display-only: it
  /// cannot block a change, fail a run or alter a verdict, so nothing has to
  /// resolve the target to decide anything. The moment a finding gained teeth
  /// this shape would need revisiting — and that is the argument for keeping it
  /// toothless, not for generalising the column.
  outcomeId String?
  /// unsupported | outside-agreement | unclear | contradicts-source
  kind      String
  detail    String

  run          AgentRun        @relation(fields: [runId], references: [id])
  change       ProposedChange? @relation(fields: [changeId], references: [id])
  shiftOutcome ShiftOutcome?   @relation(fields: [outcomeId], references: [id])

  @@index([runId])
  @@map("review_finding")
}

// ═══════════════════════════════════════════════════════════ 6. Re-entry

/// A judgment call Propositum declined to make. Rendered as a decision, never
/// as an error.
model DecisionNeeded {
  id         String @id @default(cuid())
  reportId   String
  question   String
  /// Why it stopped rather than guessing.
  whyStopped String
  /// What it would need in order to proceed.
  needs      String
  ordinal    Int

  report ShiftReport @relation(fields: [reportId], references: [id])

  @@index([reportId])
  @@map("decision_needed")
}

/// The re-entry artifact for one Shift. Written IN THE APP PROCESS when the
/// human returns — never by an AgentRun. A report producible only by a live
/// runner cannot exist on `interrupted`, the outcome that most needs one.
///
/// Holds ONE model-authored narrative line. Every other section is a
/// deterministic rendering of durable rows: completed work from the ledger,
/// changes from the Changeset, refusals from ActionIntents, gaps from
/// captureGap events, decisions from DecisionNeeded, stop from AgentRun.
/// If the narrative boundary fails, the report renders without it.
model ShiftReport {
  id         String   @id @default(cuid())
  contractId String   @unique
  /// Nullable on purpose — see above.
  narrative  String?
  createdAt  DateTime @default(now())

  contract  HandoffContract  @relation(fields: [contractId], references: [id])
  decisions DecisionNeeded[]

  @@map("shift_report")
}

// ═══════════════════════════════════════════════════ 7. Outside credentials

/// One person's authorisation to read their own free/busy, and nothing else.
/// ADR-0014.
///
/// ── This row is a REVERSAL, and the schema is where it becomes real ──────
///
/// `docs/SECURITY_AND_PRIVACY.md` says *"Everything is local. SQLite on your
/// machine. No account, no cloud, no sync, no server"*, with one named
/// exception: prompts to the Anthropic API. `docs/VISION.md` says *"Everything
/// is local. There is no cloud, no telemetry, and no account."*
///
/// A refresh token IS an account. This table doubles the secret set — until it
/// existed the only secret was `ANTHROPIC_API_KEY`, which is the app's own
/// credential and lives in `.env` — and it doubles the egress: a second host
/// Propositum talks to, on a schedule a person did not ask about. Neither
/// sentence above is true any more for somebody who connects a calendar.
/// ADR-0014 opens on that rather than on the feature.
///
/// ── Why the token is HERE and the client id is in `.env` ─────────────────
///
/// They are different kinds of thing and the split is the argument, not a
/// convenience. `GOOGLE_OAUTH_CLIENT_ID` and `GOOGLE_OAUTH_CLIENT_SECRET`
/// identify *the application* — they are the same for every copy of Propositum
/// built from this source, they are configuration, and they belong beside
/// `ANTHROPIC_API_KEY` where the app's own credentials already live. A refresh
/// token identifies *the person*. It is theirs, it arrived because they clicked
/// something, it is revocable by them, and it must disappear when they say so.
/// Data about a person belongs in their database, not in a file they edit by
/// hand and might paste into an issue.
///
/// **It is stored in the clear, and that is stated rather than dressed up.**
/// SQLite on a local disk with no application-level encryption, because a key
/// to decrypt it would have to live in `.env` beside the file it protects,
/// which is theatre. What actually protects it is the operating system's file
/// permissions and whatever full-disk encryption the machine has — the same
/// things protecting `.env` itself. The honest summary: anyone who can read
/// this file can read the token, and the mitigation is that `freebusy` grants
/// them the ability to learn when the person is busy and nothing else.
///
/// ── MUTABLE, and it gets NO append-only triggers ─────────────────────────
///
/// Project's and Intention's reasoning, unchanged: it holds no inference and
/// carries no provenance, so nothing about it is append-only. No
/// REQUIRED_GUARDS entry, no triggers.sql change, no row in
/// tests/append-only.test.ts's hand-maintained checklist. It must be DELETABLE
/// — disconnecting is the whole revocation story — and a no-DELETE trigger and
/// a revocation cannot both be true, which is `action_evidence`'s finding
/// arriving a second time.
model CalendarConnection {
  id String @id @default(cuid())

  /// Which service. UNIQUE, so at most one connection exists — the same
  /// deferral-held-as-a-shape that `Intention.projectId` uses. There is one
  /// member today, `google`, and a second one is a schema change rather than a
  /// row somebody inserts.
  provider String @unique

  /// The exact OAuth scope string that was granted, as Google returned it.
  ///
  /// Stored rather than assumed, and checked on every read. The grep in
  /// tests/calendar-scope.test.ts proves this SOURCE never asks for anything
  /// but `calendar.freebusy`; it cannot prove what a row created by an older
  /// build, or by a hand-edited authorisation URL, actually holds. A connection
  /// whose scope is not exactly the constant is refused at the read path — the
  /// feature goes quiet rather than quietly using a wider grant.
  scope String

  /// The secret. Never logged, never rendered, never in a model prompt.
  ///
  /// The repository deliberately has no method that returns a whole row: the
  /// public read returns a status object with NO token field, and the token has
  /// exactly one door named after what it is for. That is a shape rather than a
  /// rule, and it is the only reason `console.log(connection)` is not one
  /// keystroke from a leak.
  refreshToken String

  connectedAt DateTime @default(now())

  /// When Google last refused this token, or null.
  ///
  /// The ONE failure a person is eventually told about, because it is the one
  /// they can fix. Set only on an `invalid_grant` — a refusal of the credential
  /// itself — and never on a timeout, a 5xx or an unparseable body, because a
  /// flaky network that looked like a revoked grant would send somebody to
  /// re-authorise something that was working.
  refreshRejectedAt DateTime?

  updatedAt DateTime @updatedAt

  @@map("calendar_connection")
}

// ═══════════════════════════════════════ 8. What Propositum measures about itself

/// How often Propositum spoke, and how much watching produced it. One row per
/// local day, and NOTHING about what any of it was concerned with.
///
/// ── The row ADR-0008 refuses, and why this is not it ─────────────────────
///
/// [ADR-0008](../docs/adr/0008-ambient-detection.md) makes the ambient buffer
/// non-durable on purpose, and `src/server/ambient-store.ts` states the reason
/// in one sentence: *"a durable row saying 'Propositum thought you were
/// job-hunting' about an offer NOBODY ACCEPTED is exactly the profile this
/// buffer refuses to become."*
///
/// Every word of that sentence is about a SUBJECT. The refused row is refused
/// because it names what an offer was about — and this table has no column one
/// could be written in. There is no term, no signature, no origin, no title, no
/// URL, no id of anything. Four integers and a date: *four offers were shown in
/// forty observed minutes on the 18th.* Somebody reading this table learns how
/// loud the product was and cannot learn one thing about the person's work.
/// `tests/eval.test.ts` holds that as a column-by-column assertion against this
/// file rather than as an intention, because "we did not add a subject column"
/// is exactly the promise that erodes one convenient field at a time.
///
/// ── Why a day, which is the one genuinely new durable fact ───────────────
///
/// A lifetime total would be strictly less to hold, and it was rejected:
/// `docs/PRODUCT_PRINCIPLES.md` §13's hole is an offer rate *"creeping
/// upward"*, a total cannot show a change over time, and a metric that cannot
/// answer the question it was built for is decoration. A trend needs buckets,
/// so the bucket is the coarsest one that can show a trend at all.
///
/// What that does newly record, stated rather than waved past: **which days
/// this person browsed with the extension running, and roughly how much.** That
/// is real, and it is the price. It is bounded by being exactly that — an hour
/// bucket would begin to sketch a daily rhythm, which is a fact about a person
/// rather than about the product, and there is no version of the creep question
/// that needs one.
///
/// ── MUTABLE, and it gets NO append-only triggers ─────────────────────────
///
/// `Project`'s and `Intention`'s reasoning, with one addition. It holds no
/// inference and carries no provenance, so nothing about it is append-only: no
/// REQUIRED_GUARDS entry, no triggers.sql change, no row in
/// tests/append-only.test.ts's hand-maintained checklist.
///
/// The addition is that a tally is an aggregate, and an aggregate is a
/// mutation by construction — every count is an UPDATE to the same row.
/// Append-only exists so that the record of *what the product did to somebody's
/// work* cannot be quietly rewritten afterwards. Nothing is audited from this
/// table, no action is justified by it and no ledger cites it; it is the
/// product measuring its own loudness. Guarding it would also make it
/// undeletable, and a counter about a person's browsing that can never be
/// cleared is more durable than the buffer it counts — which is the wrong way
/// round.
model OfferTally {
  /// The local calendar day, `YYYY-MM-DD`. Local rather than UTC because the
  /// question is about a person's day of browsing, and UTC splits a Californian
  /// evening across two rows. See `dayBucket` in `src/server/offer-tally.ts`,
  /// which is the only writer of this value.
  day String @id

  /// Distinct minutes in which the extension had something to report while no
  /// session was running. The DENOMINATOR, and the half of an offer rate that
  /// is easy to leave out — see `src/eval/offer-rate.ts` for what it is not.
  observedMinutes Int @default(0)

  /// Strands put in front of the person: rendered on Home, or returned to the
  /// poll as the one the badge and notification name. Counted once per strand
  /// per buffer, never once per poll.
  offersShown Int @default(0)

  /// "Not now", from either decline path — the front door's per-strand one and
  /// the extension's per-origin one.
  offersDeclined Int @default(0)

  /// Strands that cleared the detector's bar, survived both snoozes, and were
  /// cut by `MAX_THREADS_SHOWN` anyway. ADR-0008: a strand found and discarded
  /// in silence is the failure the multi-strand change existed to remove, and
  /// the display bound currently does exactly that.
  strandsSuppressed Int @default(0)

  /// ── There was an `updatedAt DateTime @updatedAt` here, and it is gone ──
  ///
  /// *(Removed 2026-08-18, the day it landed, after review.)* It was copied in
  /// from the model above out of habit — every other table in this schema has
  /// one — and habit is exactly how the argument three paragraphs up gets
  /// spent. What it actually held, read back off a real row:
  /// `2026-08-18|1|6|4|0|1787090190867`, a millisecond instant, which is
  /// *Tuesday 18 August 2026 at 14:56:30 local*.
  ///
  /// `countQuietly` fires on every newly observed minute, every offer shown and
  /// every decline, so the column held the instant of the day's LAST such
  /// event — a durable, per-day record of roughly when this person stopped
  /// browsing. The docblock above refuses an hour bucket because *"an hour
  /// bucket would begin to sketch a daily rhythm, which is a fact about a
  /// person rather than about the product"*, and this field was 3,600,000
  /// times finer than the bucket that argument had already refused.
  ///
  /// It was also unread: `all()` selects the five counts and never selected
  /// this, so deleting it costs no caller. Nothing replaces it. If a
  /// bookkeeping column is ever genuinely wanted here, the thing to store is
  /// the day's own bucket string — a value already in the row — and never an
  /// instant.
  ///
  /// The four enumerations that say *"four integers and a date"*
  /// (`src/persistence/repositories/index.ts`, `src/eval/offer-rate.ts`,
  /// `src/server/ambient-store.ts`, and the paragraph above) were describing
  /// the table this now is. `src/server/actions.ts`'s *"no time of day beyond
  /// the calendar date"* was flatly false while this field existed, and is true
  /// again. `tests/eval.test.ts`'s column assertion was titled *"the five
  /// columns"* and listed six; it now lists five and means it.
  @@map("offer_tally")
}

/// One secret per install, made once and never rotated.
///
/// Exists only to salt `OfferReticence.signatureHash`. It is in the same file
/// as the rows it salts, which bounds what the hashing can claim — see
/// `src/domain/detection/reticence.ts` and ADR-0020, both of which say so rather than
/// letting the word "hash" imply more.
model InstallSecret {
  /// Always `salt`. One row, enforced by the primary key rather than by a check.
  name  String @id
  value String

  @@map("install_secret")
}

/// How often a strand has been turned down, without recording which strand.
///
/// `src/server/ambient-store.ts` refuses a durable row naming a subject nobody
/// accepted. This is the narrowest thing that answers "have they said no to
/// this before" without being that row: a salted hash, a count, and a day.
///
/// There is deliberately NO column a subject could go in — no signature, no
/// origin, no title, no url — and `tests/reticence-store.test.ts` asserts the
/// column list rather than trusting this comment.
model OfferReticence {
  /// sha256(salt + ':' + signature), hex. Never the terms themselves.
  signatureHash String @id
  /// How many times a strand hashing to this has been declined.
  declines      Int    @default(0)
  /// The local calendar day of the most recent decline, `YYYY-MM-DD`.
  ///
  /// A DATE, never an instant, and for the reason `OfferTally.updatedAt` was
  /// deleted the day it landed: a millisecond timestamp here would be a durable
  /// per-day record of roughly when this person stopped browsing.
  lastDeclinedOn String

  @@map("offer_reticence")
}
