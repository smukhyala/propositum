{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Propositum",
  "identifier": "com.propositum.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../dist-runtime/runtime": "runtime"
    },
    "externalBin": [
      "../dist-runtime/bin/node"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./entitlements.plist"
    }
  }
}
